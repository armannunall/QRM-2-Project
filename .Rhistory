skewness <- function(x) {
x <- na.omit(x)
n <- length(x)
m3 <- sum((x - mean(x))^3) / n
s3 <- (sum((x - mean(x))^2) / n)^(3/2)
return(m3 / s3)
}
kurtosis <- function(x) {
x <- na.omit(x)
n <- length(x)
m4 <- sum((x - mean(x))^4) / n
s4 <- (sum((x - mean(x))^2) / n)^2
return(m4 / s4) # Pearson kurtosis (normal distribution = 3)
}
skew_rev <- skewness(movies2$revenue, na.rm = TRUE)
skewness <- function(x) {
x <- na.omit(x)
n <- length(x)
m3 <- sum((x - mean(x))^3) / n
s3 <- (sum((x - mean(x))^2) / n)^(3/2)
return(m3 / s3)
}
kurtosis <- function(x) {
x <- na.omit(x)
n <- length(x)
m4 <- sum((x - mean(x))^4) / n
s4 <- (sum((x - mean(x))^2) / n)^2
return(m4 / s4) # Pearson kurtosis (normal distribution = 3)
}
skew_rev <- skewness(movies2$revenue)
kurt_rev <- kurtosis(movies2$revenue)
skew_log <- skewness(movies2$log_revenue)
kurt_log <- kurtosis(movies2$log_revenue)
cat("Raw Revenue  -> Skewness:", skew_rev, "| Kurtosis:", kurt_rev, "\n")
cat("Log Revenue  -> Skewness:", skew_log, "| Kurtosis:", kurt_log, "\n")
# Extract non-null revenue values
revenue_data <- na.omit(movies2$revenue)
# Calculate statistics
mean_val <- mean(revenue_data)
n <- length(revenue_data)
sem <- sd(revenue_data) / sqrt(n) # s / sqrt(n)
# Compute 90% Confidence Interval (alpha = 0.10, two-tailed)
ci_lower <- mean_val + qt(0.05, movies2 = n - 1) * sem
