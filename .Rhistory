# Summary statistics for the revenue variable
mean_rev   <- mean(movies2$revenue, na.rm = TRUE)
median_rev <- median(movies2$revenue, na.rm = TRUE)
max_rev    <- max(movies2$revenue, na.rm = TRUE)
min_rev    <- min(movies2$revenue, na.rm = TRUE)
cat("Mean:", mean_rev, "\nMedian:", median_rev, "\nMax:", max_rev, "\nMin:", min_rev)
